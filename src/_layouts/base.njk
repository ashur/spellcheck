<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">

	<!-- 🎈🐀 -->
	<meta name="generator" content="{{ eleventy.generator }}">

	<title>{{ pageTitle or title or metadata.site.title }}</title>

	<meta name="title" content="{{ metadata.site.title }}">
	<meta name="description" content="{{ metadata.site.description }}">

	<meta property="og:type" content="website">
	<meta property="og:url" content="{{ metadata.env.url }}">
	<meta property="og:title" content="{{ metadata.site.title }}">
	<meta property="og:description" content="{{ metadata.site.description }}">
	<meta property="og:image" content="{{ metadata.env.url }}/images/social.jpg">

	<meta property="twitter:card" content="summary_large_image">
	<meta property="twitter:url" content="{{ metadata.env.url }}">
	<meta property="twitter:title" content="Spell Check">
	<meta property="twitter:description" content="{{ metadata.site.description }}">
	<meta property="twitter:image" content="{{ metadata.env.url }}/images/social.jpg">

	{% set style %}
		{% include "css/reset.css" %}
		{% include "css/fonts.css" %}
		{% include "css/utilities.css" %}
	{% endset %}
	<style>
		{{ style | cssmin | safe }}

		body {
			background-color: light-dark(#fafafa, #222);
			color: light-dark(#444, #ddd);
			display: grid;
			font-weight: 450;
			min-height: 100svh;
			padding: calc(24 / 16 * 1rem);
			place-content: center;
			text-align: center;
		}

		strong {
			color: light-dark(#222, #fafafa);
			font-weight: 600;
		}
	</style>

 	<script defer data-domain="spellcheck.fun" src="/js/script.tagged-events.js"></script>
</head>
<body>
	{{ content | safe }}
</body>
</html>
